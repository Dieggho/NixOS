{
    "output": ["eDP-1"],
    "spacing": 4,
		// try to keep it 4px across the config
    "height":33,
     "margin-left": 6,
     "margin-right": 6,
     "margin-top": 6,
     "margin-radius": 6,
    // "layer": "top",
    "modules-left": ["custom/menu", "ext/workspaces" ],
    "modules-right": ["cpu", "memory", "battery", "battery#bat1",  "clock", "network#net1", "pulseaudio",  "custom/session"],
    "battery": {
        "format": "{icon} {capacity}% ",
	"interval": 10,
    },
   
	"custom/menu": {
        "format": "               ",
        "tooltip": false,
        "on-click": "/home/void/.sh/wenu",
        "on-click-middle": "foot",
        "on-click-right": "pkill wofi",
    },

    "wlr/taskbar": {
    "format": "{icon}",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-right": "minimize",
    "on-click-middle": "close",
    "icon-size": 22,
    },

   "ext/workspaces": {
    //"format": "   {name}   ",
    //"sort-by-id": true,
	  "format": "   {icon}   ",
	  "format-icons": {
		"1":"Main",
		"2":"Web",
		"3":"Net",
		"4":"Doc",
		"5":"Term",
		"6":"Media",
		"7":"Desk",
	},
    "on-click": "activate",
    //"on-scroll-up": "wtype -M logo -k 8 -m logo",
    //"on-scroll-down": "wtype -M logo -k 9 -m logo",
    "on-scroll-up": "rollup",
    "on-scroll-down": "rolldown",
   },

     // "network": {
     // "interface": "wlp2s0",
     // "format": "{ifname}",
     // "format-wifi": " {bandwidthDownBytes}    {bandwidthUpBytes}",
     // "max-length": 50,
     // "interval": 1,
     // },

     "network#net1": {
     // "interface": "wlp2s0",
     "format": "{ifname}",
     "format-wifi": " {signalStrength}%",
     "format-ethernet": " {ifname} ",
     "format-disconnected": "", //An empty format will hide the module.
     "format-disconnected": "",
     "tooltip-format": "{ifname}",
     "tooltip-format-wifi": "  {essid} ({signalStrength}%)  ",
     "tooltip-format-ethernet": " {ifname} ",
     "tooltip-format-disconnected": "Disconnected",
     "interval": 1,
     "on-click": "iwgtk"
     },

    "clock": {
        // "timezone": "America/Sao_Paulo",
        // "tooltip-format": "<big>[{:%Y %B}]</big>\n<tt><small>{calendar}</small></tt>",
        "format": " {:%A %d %B %Y     %T}",
	"interval": 1,
	"on-click": "gsimplecal",
    },

    "cpu": {
        "format": " {usage}%",
        "on-click": "lxtask",
	"interval": 1,
    },

    "memory": {
        "format": " {percentage}%",
        "on-click": "lxtask",
	"interval": 1,
    },

    "battery": {
	"bat": "BAT0",
        "format": " {capacity}%",
	"interval": 1,
    },

    "battery#bat1": {
	"bat": "BAT1",
        "format": " {capacity}%",
	"interval": 1,
    },

    "custom/alsa": {
        "exec": "echo  `vol`",
        "on-click": "Amixer",
        "on-scroll-up": "amixer set Master 1+; pkill -x -RTMIN+11 waybar",
        "on-scroll-down": "amixer set Master 1-; pkill -x -RTMIN+11 waybar",
        "signal": 11,
        "interval": 1,
        "tooltip": false
    },

   "pulseaudio": {
         "format": "{icon} {volume}%",
         "format-bluetooth": "{icon} {volume}%",
         "format-muted": "",
         "format-icons": {
              "headphones": "",
              "handsfree": "",
              "headset": "",
              "phone": "",
              "portable": "",
              "car": "",
              "default": ["", ""]
             },
         "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+; pkill -x -RTMIN+11 waybar",
         "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-; pkill -x -RTMIN+11 waybar",
         "on-click": "pavucontrol",
     },

	"custom/session": {
        "format": "  ⏻  ",
        "tooltip": false,
        "on-click": "/home/void/.sh/wsession",
        "on-click-right": "pkill wofi",
    },
}
